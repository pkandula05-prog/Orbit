<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Everything the build system can generate is generated: this file only carries the
	     keys it cannot (GENERATE_INFOPLIST_FILE merges the rest in). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.orbit.compass.join</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>orbit</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Archivo-Regular.ttf</string>
		<string>Archivo-SemiBold.ttf</string>
		<string>Archivo-Bold.ttf</string>
	</array>
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>OrbitFeedURL</key>
	<string>$(ORBIT_FEED_URL)</string>
	<key>OrbitFeedToken</key>
	<string>$(ORBIT_FEED_TOKEN)</string>
</dict>
</plist>
