{
  "expo": {
    "name": "Orbit",
    "slug": "orbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f3f2f2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orbit.compass",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Orbit uses your location and compass to show which way your friends are and how far away they are."
      }
    },
    "android": {
      "package": "com.orbit.compass",
      "adaptiveIcon": {
        "backgroundColor": "#f3f2f2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Orbit uses your location and compass to show which way your friends are and how far away they are."
        }
      ]
    ]
  }
}
